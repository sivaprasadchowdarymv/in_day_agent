# BharatTrade AI – copy to .env and edit. NEVER commit your real .env file.

# ---------- Market data ----------
# yahoo_nse = Yahoo candles + NSE public-website quotes, order book, circuits, breadth, holidays (free, recommended)
# yahoo     = free Yahoo Finance data only (DELAYED, no key needed)
# simulated = demo mode with synthetic prices (clearly labelled, NOT market data)
BT_DATA_PROVIDER=yahoo_nse
BT_MAX_SYMBOLS=60

# ---------- Trading profile (capital must stay below ₹50,000) ----------
BT_CAPITAL=30000
BT_RISK_PCT=0.5
BT_MAX_ALLOC_PCT=25
BT_ALLOW_SHORT=true

# ---------- Optional free AI providers (leave blank to disable) ----------
# none | gemini | groq | openrouter
BT_LLM_PROVIDER=none
BT_LLM_MODEL=
BT_LLM_VISION_MODEL=
# Google AI Studio free key:  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free key:              https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter key (choose a ":free" model in BT_LLM_MODEL): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------- OCR (Windows: path to tesseract.exe if not on PATH) ----------
TESSERACT_CMD=

# ---------- Database (blank = local SQLite in storage/) ----------
# PostgreSQL example: postgresql+psycopg://user:pass@localhost:5432/bharattrade
DATABASE_URL=

BT_LOG_LEVEL=INFO
BT_MAX_UPLOAD_MB=8
